{
  "name": "zovo-azure-storage-explorer",
  "displayName": "Azure Storage & Azure Blob Storage Explorer (Blob, Queue, Table, Azurite)",
  "description": "Free Azure Storage explorer for Azure Blob Storage, Queue Storage and Table Storage in VS Code, Cursor and Codespaces. Connect with a connection string, account key, SAS URL, Azurite in one click, or Entra ID: no Azure sign-in needed. Browse containers with paging, upload and download big files with a transfer queue, SAS URLs, access tiers, peek and send queue messages, query and edit table entities. Not made by Microsoft. No telemetry.",
  "version": "0.1.0",
  "publisher": "zovo",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#10243E",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=18"
  },
  "categories": [
    "Azure",
    "Other"
  ],
  "keywords": [
    "azure storage",
    "azure blob storage",
    "blob storage",
    "storage explorer",
    "azure blob",
    "azurite",
    "sas",
    "queue storage",
    "table storage",
    "adls"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onFileSystem:azblob"
  ],
  "extensionKind": [
    "workspace",
    "ui"
