    "configuration": {
      "title": "Azure Storage",
      "properties": {
        "azureStorage.pageSize": {
          "type": "integer",
          "default": 1000,
          "minimum": 50,
          "maximum": 5000,
          "description": "Containers, blobs, queues and tables listed per page in the tree. A \"Load more\" row fetches the next page."
        },
        "azureStorage.maxTextPreviewMB": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 256,
          "description": "Text blobs larger than this ask first: show the first 1 MB (one range request) or download the whole blob."
        },
        "azureStorage.confirmOpenOverMB": {
          "type": "number",
          "default": 200,
          "minimum": 1,
          "description": "Binary blobs larger than this ask before they are downloaded to open."
        },
        "azureStorage.blockSizeMB": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "maximum": 4000,
          "description": "Block size for uploads of large files. It grows for very large files so that there are at most 50,000 blocks."
        },
        "azureStorage.concurrency": {
          "type": "integer",
          "default": 4,
          "minimum": 1,
          "maximum": 16,
          "description": "Blocks of one file sent at the same time."
        },
        "azureStorage.parallelTransfers": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "maximum": 8,
          "description": "Files in the transfer queue that upload or download at the same time."
        },
        "azureStorage.requestTimeoutSeconds": {
          "type": "integer",
          "default": 30,
          "minimum": 5,
          "maximum": 600,
          "description": "How long to wait for one answer from the storage endpoint before it is retried and then shown as an error."
        },
        "azureStorage.syncExcludes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".git/**",
            "node_modules/**",
            ".DS_Store",
            "Thumbs.db"
          ],
          "description": "Glob patterns that folder uploads and sync skip (** matches folders)."
        },
        "azureStorage.queueMessageEncoding": {
          "type": "string",
          "enum": [
            "text",
            "base64"
          ],
          "default": "text",
          "description": "How the queue page sends a new message at first: as plain text, or Base64-encoded (what Azure Functions queue triggers expect). The page remembers your last choice."
        },
        "azureStorage.pricePerGBMonth": {
          "type": "object",
          "default": {},
          "properties": {
            "Hot": {
              "type": "number"
            },
            "Cool": {
              "type": "number"
            },
            "Cold": {
              "type": "number"
            },
            "Archive": {
              "type": "number"
            }
          },
          "description": "Your storage prices in USD per GB-month for the usage report, for example {\"Hot\": 0.02}. Empty uses list prices (LRS, East US)."
        },
        "azureStorage.askForRating": {
          "type": "boolean",
          "default": true,
          "description": "Ask for a rating after 2 blobs opened without an error, in 2 sessions at least 4 hours apart. \"Later\" asks once more after 7 days, \"No thanks\" never asks again. Never after an error. Nothing is sent anywhere."
        },
        "azureStorage.showSupportLinks": {
          "type": "boolean",
          "default": true,
          "description": "Show the small Rate, More free tools and Sponsor links at the bottom of the details, queue, table and report pages. Nothing is sent anywhere."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "azureStorage.start",
        "title": "Get started with Azure Storage Explorer",
        "description": "Connect, browse, transfer, and work with queues and tables.",
        "steps": [
          {
            "id": "connect",
            "title": "Add a connection",
            "description": "Paste a connection string or a SAS URL, type an account name and key, or click Azurite for the local emulator. No Azure sign-in is needed. Keys go to the OS keychain.\n[Add Connection](command:azureStorage.addConnection)\n[Connect to Azurite](command:azureStorage.connectAzurite)",
            "media": {
              "image": "images/screenshot-dark.png",
              "altText": "The Storage Accounts view with a container open and the properties of a blob."
            },
            "completionEvents": [
              "onCommand:azureStorage.addConnection",
              "onCommand:azureStorage.connectAzurite"
            ]
          },
          {
            "id": "browse",
            "title": "Browse and open",
            "description": "Expand a container. Blobs load 1,000 at a time with folders by \"/\", so a container with millions of blobs opens at once. Click a blob to open it: text and JSON in an editor tab, PDFs, spreadsheets and Parquet in the matching viewer.",
            "media": {
              "markdown": "walkthrough/browse.md"
            }
          },
          {
            "id": "transfer",
            "title": "Upload and download",
            "description": "Drag files from your desktop onto a container or folder. Big files upload in blocks with progress. The Transfers view has Cancel and Retry for each file.",
            "media": {
              "markdown": "walkthrough/transfer.md"
            }
          },
          {
            "id": "queues",
            "title": "Queues and tables",
            "description": "Click a queue to peek, send, dequeue or clear messages. Click a table to query it with an OData filter and edit entities in a grid.",
            "media": {
              "markdown": "walkthrough/queues.md"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.js --production",
